root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break
[*.{md,mdx}]
trim_trailing_whitespace = false

# Xcode and SwiftLint default; keep swift-format's `indentation` in sync
[*.swift]
indent_size = 4

# Xcode-generated, written with tabs
[*.pbxproj]
indent_style = tab
