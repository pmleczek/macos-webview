{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Setup
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
  },
  "env": {
    "builtin": true,
    "es2024": true,
  },
  "options": {
    "reportUnusedDisableDirectives": "warn",
  },
  "ignorePatterns": ["**/GeneratedModules/**"],
  // Rules
  "rules": {
    "eqeqeq": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-explicit-any": "warn",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    // Type-aware (active once `oxlint-tsgolint` is installed and `typeAware` is on)
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
  },
  // Overrides
  "overrides": [
    {
      // Runs inside WKWebView: browser APIs only, never Node
      "files": ["packages/core/**", "modules/*/src/**"],
      "env": { "browser": true },
      "rules": {
        "import/no-nodejs-modules": "error",
      },
    },
    {
      "files": ["**/*.tsx", "**/*.jsx", "packages/react/**"],
      "plugins": ["react", "react-perf", "jsx-a11y"],
      "env": { "browser": true },
      "rules": {
        "react/rules-of-hooks": "error",
        // Duplicates rules-of-hooks
        "react/hooks": "off",
        "react/exhaustive-deps": "warn",
        "react/react-in-jsx-scope": "off",
      },
    },
    {
      // CLI, scaffolder and tooling run in Node
      "files": [
        "packages/cli/**",
        "packages/create-*/**",
        "scripts/**",
        "**/*.config.{ts,mts,js,mjs}",
      ],
      "plugins": ["node"],
      "env": { "node": true },
      "rules": {
        "no-console": "off",
        "unicorn/prefer-node-protocol": "error",
      },
    },
    {
      // Config files (vite, macos-webview) expect a default export
      "files": ["**/*.config.{ts,mts,js,mjs}"],
      "rules": {
        "import/no-default-export": "off",
      },
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}", "**/__tests__/**"],
      "plugins": ["vitest"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off",
      },
    },
  ],
}
